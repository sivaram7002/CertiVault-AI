# Google Gemini API Key for CertiVault AI (Optional)
# If not provided, CertiVault AI automatically operates using its built-in Intelligent Forensic Simulation Engine.
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Supabase Cloud Database Configuration (Optional)
# If provided, all uploaded certificates and forensic scans are stored in your Supabase PostgreSQL database.
# You can also configure these directly in the CertiVault AI web UI (Navbar > Connect DB).
# 1. Sign up for free at: https://supabase.com
# 2. In your Supabase Project: Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
